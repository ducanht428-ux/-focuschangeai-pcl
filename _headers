# Cloudflare Pages: tiêu đề HTTP cho toàn bộ site.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()

# Service worker phải luôn được kiểm tra lại, để bản mới tới tay người dùng ngay.
/sw.js
  Cache-Control: no-cache

# Model và wasm nặng, ít khi đổi: cho trình duyệt giữ 7 ngày để lần mở sau nhanh hơn.
/wasm/*
  Cache-Control: public, max-age=604800
/wasm-ort/*
  Cache-Control: public, max-age=604800
/sqljs/*
  Cache-Control: public, max-age=604800
/yolo11n.onnx
  Cache-Control: public, max-age=604800
/face_landmarker.task
  Cache-Control: public, max-age=604800
/efficientdet_lite0.tflite
  Cache-Control: public, max-age=604800

# Code của app: luôn kiểm tra bản mới (nhận 304 nếu chưa đổi), tránh kẹt bản cũ như lần trước.
/dashboard/*
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/benchmark.html
  Cache-Control: no-cache
